DirectoryIndex index.html

RewriteEngine On

# Canonicalize generated page directories. A request without the final slash
# redirects to the one public version used in sitemap.xml and canonical tags.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# Let real files and generated page directories be served normally.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
